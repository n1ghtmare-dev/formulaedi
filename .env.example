# ——— База данных (MySQL / MariaDB) ———
# Локально через Docker: docker compose up -d
DATABASE_URL="mysql://formulaedi:formulaedi@localhost:3306/formulaedi"

# ——— Redis (очереди BullMQ: отложенное начисление формул, сгорание) ———
REDIS_URL="redis://localhost:6379"

# ——— API ———
API_PORT=4000
NODE_ENV=development
# CORS origin фронтенда
WEB_ORIGIN="http://localhost:6060"

# ——— JWT ———
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ——— SMS-провайдер (SMS.ru / SMSC). Пока dev-режим: код пишется в лог ———
# ——— Почта: подтверждение шлётся локальным PHP-скриптом (deploy/mailer.php) в проде.
# В dev (NODE_ENV≠production) ссылка пишется в лог/показывается в кабинете. Доп. переменные не нужны.

# ——— Платежи PayKeeper (пусто → dev-режим: оплата подтверждается заглушкой) ———
PAYKEEPER_SERVER=""
PAYKEEPER_USER=""
PAYKEEPER_PASSWORD=""
PAYKEEPER_SECRET=""

# ——— Бизнес-параметры (значения по умолчанию, дублируются в таблице настроек) ———
FORMULA_EARN_PERCENT=7
FORMULA_SPEND_MAX_PERCENT=25

# ——— Фронтенд (Vite) ———
VITE_API_URL="http://localhost:4000"
