# Шаблон .env для ПРОДАКШЕНА (formulaedi.ru). На сервере скопируйте в .env (в корень репозитория)
# и подставьте реальные значения. НЕ коммитить .env в git!

# ——— База данных (MySQL из FastPanel) ———
#
# ВАЖНО: FastPanel заводит пользователя БД как user@localhost, то есть доступ
# только через unix-сокет. Prisma по умолчанию ходит по TCP на 127.0.0.1 и
# получает «Access denied». Поэтому обязателен параметр ?socket=
# (путь смотреть в SHOW VARIABLES LIKE 'socket'; на этом сервере — /run/mysqld/mysqld.sock).
#
# Спецсимволы в пароле надо URL-кодировать: ) = %29, , = %2C, : = %3A, > = %3E, @ = %40
DATABASE_URL="mysql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:3306/БАЗА?socket=/run/mysqld/mysqld.sock"

# ——— API ———
API_PORT=4000
NODE_ENV=production
WEB_ORIGIN="https://formulaedi.ru"

# ——— JWT (сгенерируйте случайные строки: openssl rand -hex 32) ———
JWT_ACCESS_SECRET="ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ"
JWT_REFRESH_SECRET="ЗАМЕНИТЕ_НА_ДРУГУЮ_СЛУЧАЙНУЮ_СТРОКУ"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ——— SMS (SMS.ru / SMSC) — когда подключите ———
# ——— Почта: подтверждение отправляет локальный PHP-скрипт deploy/mailer.php (php CLI + mail()).
# Никаких доп. переменных не нужно: адрес ссылки берётся из запроса, режим — из NODE_ENV=production.

# ——— Платежи PayKeeper (JSON API) ———
# PAYKEEPER_SERVER   — адрес личного кабинета, вида https://<имя>.server.paykeeper.ru
# PAYKEEPER_USER/PASSWORD — логин/пароль для JSON API (Basic auth, из кабинета)
# PAYKEEPER_SECRET   — «секретное слово» POST-оповещений (Настройки → Получение информации о платежах)
# В кабинете PayKeeper указать URL оповещений: https://formulaedi.ru/api/payments/paykeeper/callback
# и success-редирект: https://formulaedi.ru/?paid=1
PAYKEEPER_SERVER=""
PAYKEEPER_USER=""
PAYKEEPER_PASSWORD=""
PAYKEEPER_SECRET=""

# ——— Бизнес-параметры ———
FORMULA_EARN_PERCENT=7
FORMULA_SPEND_MAX_PERCENT=25

# Витрина в проде ходит на /api того же домена (Nginx проксирует) — VITE_API_URL не нужен.
